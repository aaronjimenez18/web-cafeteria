<section id="menu" class="menu-section">
  <div class="menu-container">
    <h2 class="menu-title">Menú</h2>

    {menuSections.map((section) => (
      <div class="category-block">
        <h3 class="category-title">{section.category}</h3>

        <div class="items-grid">
          {section.items.map((item) => (
            <div class="menu-card">
              <div class="card-content">
                <h4 class="item-name">{item.name}</h4>
                <p class="item-desc">{item.description}</p>
              </div>
              <div class="price-badge">{item.price}</div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Rubik:wght@500&display=swap");
  @import url("https://fonts.googleapis.com/css2?family=Archivo+Black&family=Monofett&family=Rubik:wght@500&display=swap");
  .menu-section {
    background: #0f0b0a;
    color: #ffffff;
    padding: clamp(60px, 10vw, 80px) clamp(16px, 5vw, 20px);
    font-family: "Rubik", sans-serif;
    font-optical-sizing: auto;
    font-weight: 500;
    font-style: normal;
  }

  .menu-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .menu-title {
    font-family: "Monofett", monospace;
    font-weight: 400;
    font-style: normal;
    text-align: center;
    font-size: clamp(2.5rem, 8vw, 4rem);
  }

  .category-block {
    margin-bottom: clamp(40px, 8vw, 60px);
  }

  .category-title {
    font-family: "Rubik", sans-serif;
    font-weight: 900;
    font-style: normal;
    font-size: clamp(1.5rem, 5vw, 2.25rem);
    border-bottom: 2px solid var(--bg);
    padding-bottom: 10px;
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .items-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: clamp(14px, 2vw, 20px);
  }

  .menu-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: clamp(14px, 3vw, 18px);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 15px;
    position: relative;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .menu-card:hover {
    transform: translateY(-4px);
    border-color: var(--bg);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5);
  }

  .card-content {
    flex: 1;
    min-width: 0;
  }

  .item-name {
    font-size: clamp(1.15rem, 3vw, 1.4rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 6px 0;
    letter-spacing: 0.5px;
    overflow-wrap: break-word;
  }

  .item-desc {
    font-size: 0.85rem;
    color: #b0a8a0;
    margin: 0;
    line-height: 1.4;
    overflow-wrap: break-word;
  }

  .price-badge {
    background: var(--bg);
    color: #ffffff;
    font-weight: 700;
    font-size: clamp(1rem, 2.5vw, 1.1rem);
    padding: 6px 12px;
    border-radius: 8px;
    white-space: nowrap;
    flex-shrink: 0;
    box-shadow: 0 4px 10px rgba(255, 106, 0, 0.3);
  }

  @media (max-width: 600px) {
    .menu-card {
      flex-wrap: wrap;
      align-items: center;
    }

    .card-content {
      flex: 1 1 100%;
    }

    .price-badge {
      margin-top: 4px;
    }
  }
</style>
